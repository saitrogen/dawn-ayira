{{ 'section-ayira-home.css' | asset_url | stylesheet_tag }}

{%- assign intro_products = section.settings.products | where: 'featured_image' -%}
<div class="ayira-home-intro page-width">
  <div class="ayira-home-intro__panel{% if intro_products.size == 0 %} ayira-home-intro__panel--text-only{% endif %} color-{{ section.settings.color_scheme }}">
    <div class="ayira-home-intro__content">
      {%- if section.settings.heading != blank -%}
        <h1 class="ayira-home-intro__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="ayira-home-intro__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
      <div class="ayira-home-intro__actions">
        {%- if section.settings.button_label != blank -%}
          <a class="button button--primary" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
            {{ section.settings.button_label | escape }}
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a class="ayira-home-intro__link" href="{{ section.settings.secondary_link | default: routes.collections_url }}">
            {{ section.settings.secondary_label | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>
    {%- if intro_products.size > 0 -%}
      <div class="ayira-home-intro__products" style="--intro-product-count: {{ intro_products.size }};">
        {%- for product in intro_products -%}
          {%- liquid
            assign fetch_priority = 'auto'
            if forloop.first and section.index == 1
              assign fetch_priority = 'high'
            endif
          -%}
            <a class="ayira-home-intro__product" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
              {{
                product.featured_image
                | image_url: width: 600
                | image_tag:
                  widths: '160, 240, 360, 480, 600',
                  sizes: '(min-width: 990px) 200px, (min-width: 750px) 160px, 28vw',
                  loading: 'eager',
                  fetchpriority: fetch_priority,
                  alt: '',
                  class: 'ayira-home-intro__image'
              }}
            </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Ayira home intro",
  "tag": "section",
  "class": "section section-ayira-home-intro",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Your everyday groceries, all in one place." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Fill your basket with drinks, snacks and everyday essentials.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop groceries" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary link label", "default": "Browse categories" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" },
    { "type": "product_list", "id": "products", "label": "Featured product images", "limit": 3, "info": "Choose up to three products. Each image links to its product page." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-3" }
  ],
  "presets": [{ "name": "Ayira home intro" }]
}
{% endschema %}
