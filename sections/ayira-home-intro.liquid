{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'section-ayira-home.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign slide_count = 0
  for block in section.blocks
    if request.design_mode or block.settings.collection.all_products_count > 0
      assign slide_count = slide_count | plus: 1
    endif
  endfor
-%}

{%- if slide_count > 0 -%}
  <div class="ayira-campaigns page-width color-{{ section.settings.color_scheme }}">
    <slideshow-component
      class="ayira-campaigns__carousel"
      role="region"
      aria-roledescription="carousel"
      aria-label="{{ 'sections.ayira_hero_banner.carousel_label' | t }}"
    >
      <div
        id="Slider-{{ section.id }}"
        class="ayira-campaigns__track slider slider--everywhere"
        data-autoplay="false"
        aria-live="polite"
      >
        {%- assign slide_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- unless request.design_mode -%}
            {%- unless block.settings.collection.all_products_count > 0 -%}{%- continue -%}{%- endunless -%}
          {%- endunless -%}
          {%- liquid
            assign slide_index = slide_index | plus: 1
            assign collection = block.settings.collection
            assign heading = block.settings.heading | default: collection.title
            if heading == blank
              assign heading = 'onboarding.collection_title' | t
            endif
            assign artwork = block.settings.image | default: block.settings.mobile_image
            assign image = artwork | default: collection.featured_image
            assign image_sizes = '40vw'
            if artwork != blank
              assign image_sizes = '100vw'
            endif
            assign heading_tag = 'h2'
            if slide_index == 1
              assign heading_tag = 'h1'
            endif
            assign loading = 'lazy'
            assign priority = 'auto'
            if slide_index == 1
              assign loading = 'eager'
              if section.index == 1
                assign priority = 'high'
              endif
            endif
          -%}
          <div
            id="Slide-{{ section.id }}-{{ slide_index }}"
            class="ayira-campaigns__slide slideshow__slide slider__slide"
            role="group"
            aria-roledescription="slide"
            aria-label="{{ slide_index }} {{ 'general.slider.of' | t }} {{ slide_count }}"
            {{ block.shopify_attributes }}
          >
            <a
              class="ayira-campaign{% if artwork != blank %} ayira-campaign--artwork{% endif %}{% if image == blank %} ayira-campaign--text-only{% endif %} color-{{ block.settings.color_scheme }}"
              href="{{ collection.url | default: routes.collections_url }}"
              aria-label="{{ heading | strip_html | escape }} — {{ collection.title | default: heading | strip_html | escape }}"
            >
              <div class="ayira-campaign__content">
                <{{ heading_tag }} class="ayira-campaign__heading{% if artwork != blank and block.settings.heading == blank %} visually-hidden{% endif %}">{{ heading }}</{{ heading_tag }}>
                {%- if block.settings.text != blank -%}
                  <p class="ayira-campaign__text">{{ block.settings.text | escape }}</p>
                {%- endif -%}
                {%- if block.settings.button_label != blank -%}
                  <span class="ayira-campaign__action">
                    {{ block.settings.button_label | escape }}
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
                  </span>
                {%- endif -%}
              </div>
              {%- if image != blank -%}
                <picture class="ayira-campaign__media">
                  {%- if block.settings.mobile_image != blank -%}
                    <source media="(max-width: 749px)" srcset="{{ block.settings.mobile_image | image_url: width: 400 }} 400w, {{ block.settings.mobile_image | image_url: width: 750 }} 750w" sizes="calc(100vw - 30px)">
                  {%- endif -%}
                  {{ image | image_url: width: 1800 | image_tag: widths: '200, 400, 600, 900, 1200, 1800', sizes: image_sizes, loading: loading, fetchpriority: priority, alt: '', class: 'ayira-campaign__image' }}
                </picture>
              {%- endif -%}
            </a>
          </div>
        {%- endfor -%}
      </div>
      {%- if slide_count > 1 -%}
        <div class="ayira-campaigns__controls slider-buttons no-js-hidden">
          <button class="slider-button slider-button--prev" type="button" name="previous" aria-label="{{ 'general.slider.previous_slide' | t }}" aria-controls="Slider-{{ section.id }}">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
          </button>
          <div class="ayira-campaigns__dots" aria-label="{{ 'sections.ayira_hero_banner.pagination_label' | t }}">
            {%- assign slide_index = 0 -%}
            {%- for block in section.blocks -%}
              {%- unless request.design_mode -%}
                {%- unless block.settings.collection.all_products_count > 0 -%}{%- continue -%}{%- endunless -%}
              {%- endunless -%}
              {%- assign slide_index = slide_index | plus: 1 -%}
              <button
                type="button"
                class="ayira-campaigns__dot slider-counter__link{% if slide_index == 1 %} slider-counter__link--active{% endif %}"
                aria-label="{{ 'sections.ayira_hero_banner.go_to_slide' | t: number: slide_index }}"
                aria-controls="Slider-{{ section.id }}"
                {% if slide_index == 1 %}aria-current="true"{% endif %}
              ><span aria-hidden="true"></span></button>
            {%- endfor -%}
          </div>
          <button class="slider-button slider-button--next" type="button" name="next" aria-label="{{ 'general.slider.next_slide' | t }}" aria-controls="Slider-{{ section.id }}">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
          </button>
        </div>
      {%- endif -%}
    </slideshow-component>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Ayira collection carousel",
  "tag": "section",
  "class": "section section-ayira-campaigns",
  "max_blocks": 6,
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Page and controls color scheme", "default": "scheme-1" }
  ],
  "blocks": [{
    "type": "campaign",
    "name": "Collection campaign",
    "settings": [
      { "type": "collection", "id": "collection", "label": "Collection", "info": "The whole slide links to this collection. Empty collections are hidden outside the editor." },
      { "type": "inline_richtext", "id": "heading", "label": "Heading", "info": "Uses the collection title when empty. Leave empty with campaign artwork to hide the text overlay." },
      { "type": "text", "id": "text", "label": "Supporting text", "info": "Shown on larger screens." },
      { "type": "text", "id": "button_label", "label": "Action label", "default": "Shop collection" },
      { "type": "image_picker", "id": "image", "label": "Campaign artwork", "info": "Optional full-width poster. Leave empty to show the collection image beside your text." },
      { "type": "image_picker", "id": "mobile_image", "label": "Mobile campaign artwork", "info": "Optional phone version of your campaign poster." },
      { "type": "color_scheme", "id": "color_scheme", "label": "Slide color scheme", "default": "scheme-3" }
    ]
  }],
  "presets": [{ "name": "Ayira collection carousel", "blocks": [{ "type": "campaign" }, { "type": "campaign" }, { "type": "campaign" }] }]
}
{% endschema %}
