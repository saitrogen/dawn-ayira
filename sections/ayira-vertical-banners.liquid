{{ 'section-ayira-vertical-banners.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #AyiraVerticalBanners-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    #AyiraVerticalBanners-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  id="AyiraVerticalBanners-{{ section.id }}"
  class="color-{{ section.settings.color_scheme | default: 'scheme-1' }} gradient"
>
  <div class="ayira-vertical-banners page-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    {% render 'ayira-section-header',
      eyebrow: section.settings.eyebrow,
      title: section.settings.title,
      show_view_all: section.settings.show_view_all,
      view_all_label: section.settings.view_all_label,
      view_all_url: section.settings.view_all_link
    %}

    {%- if section.blocks.size > 0 -%}
      <ul class="ayira-vertical-banners__track" role="list">
        {%- for block in section.blocks -%}
          <li
            class="ayira-vertical-banners__track-item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {{ block.shopify_attributes }}
            {% if settings.animations_reveal_on_scroll %}
              style="--animation-order: {{ forloop.index }};"
              data-cascade
            {% endif %}
          >
            {%- comment -%}
              A banner without a link is a plain card, not a disabled link:
              an anchor with no href is neither focusable nor activatable.
            {%- endcomment -%}
            {%- if block.settings.link != blank -%}
              <a
                href="{{ block.settings.link }}"
                class="ayira-vertical-banner"
                style="--banner-bg: {{ block.settings.background_color }}; --banner-fg: {{ block.settings.text_color }};"
              >
            {%- else -%}
              <div
                class="ayira-vertical-banner"
                style="--banner-bg: {{ block.settings.background_color }}; --banner-fg: {{ block.settings.text_color }};"
              >
            {%- endif -%}

            {%- if block.settings.title != blank -%}
              <p class="ayira-vertical-banner__title">{{ block.settings.title }}</p>
            {%- endif -%}

            {%- if block.settings.image != blank -%}
              <div class="ayira-vertical-banner__media">
                {%- comment -%}
                  alt is empty: the heading above already names the banner,
                  so alt text would make screen readers say it twice.
                {%- endcomment -%}
                {{
                  block.settings.image
                  | image_url: width: 800
                  | image_tag:
                    width: block.settings.image.width,
                    height: block.settings.image.height,
                    alt: '',
                    class: 'ayira-vertical-banner__img motion-reduce',
                    loading: 'lazy',
                    widths: '200, 300, 400, 500, 600, 700, 800',
                    sizes: '(min-width: 750px) 220px, 40vw'
                }}
              </div>
              <div class="ayira-vertical-banner__overlay" aria-hidden="true"></div>
            {%- endif -%}

            {%- if block.settings.link != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Ayira Vertical Banners",
  "tag": "section",
  "class": "section",
  "max_blocks": 20,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Browse"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": true,
      "label": "Show view all link"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all link text",
      "default": "All collections"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link URL",
      "info": "Leave empty to link to the collections page."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Vertical Banner",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Banner image"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Heading",
          "default": "Category name"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Card background color",
          "default": "#0D4F47",
          "info": "Only visible on banners without an image."
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Card text color",
          "default": "#FFFFFF"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ayira Vertical Banners",
      "blocks": [
        { "type": "banner" },
        { "type": "banner" },
        { "type": "banner" }
      ]
    }
  ]
}
{% endschema %}
