{{- 'section-ayira-collection-list.css' | asset_url | stylesheet_tag -}}
{{ 'component-card.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #AyiraCollectionList-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    #AyiraCollectionList-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  id="AyiraCollectionList-{{ section.id }}"
  class="color-{{ section.settings.color_scheme }} gradient"
>
  <div class="ayira-collection-list page-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">

    {%- comment -%} ── Section Header ────────────────────────────────────── {%- endcomment -%}
    <div class="ayira-collection-list__header">
      <div class="ayira-collection-list__header-left">
        {%- if section.settings.eyebrow != blank -%}
          <span class="ayira-collection-list__eyebrow">
            {{- section.settings.eyebrow | escape -}}
          </span>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="ayira-collection-list__title">
            {{- section.settings.title -}}
          </h2>
        {%- endif -%}
      </div>

      {%- if section.settings.show_view_all -%}
        <a
          href="{{ routes.collections_url }}"
          class="ayira-collection-list__view-all"
          aria-label="{{ 'sections.collection_list.view_all' | t }}"
        >
          {{- section.settings.view_all_label | default: 'All collections' | escape -}}
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M3 8H13M13 8L8.5 3.5M13 8L8.5 12.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      {%- endif -%}
    </div>

    {%- comment -%} ── Collection Tiles Track ─────────────────────────── {%- endcomment -%}
    <div class="ayira-collection-list__track">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {% render 'ayira-collection-tile',
            col: block.settings.collection,
            show_title: section.settings.show_collection_title,
            show_count: section.settings.show_product_count,
            animation_order: forloop.index,
            block_attributes: block.shopify_attributes
          %}
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} No blocks — render placeholder tiles {%- endcomment -%}
        {%- for i in (1..5) -%}
          {% render 'ayira-collection-tile',
            show_title: section.settings.show_collection_title,
            show_count: section.settings.show_product_count,
            animation_order: forloop.index
          %}
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Ayira Collection List",
  "tag": "section",
  "class": "section section-ayira-collection-list",
  "max_blocks": 20,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Shop by Aisle",
      "info": "Small label above the title (e.g. 'Shop by Category')"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Section Title",
      "default": "Browse our collections"
    },
    {
      "type": "header",
      "content": "View All Link"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'All collections' link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Link label",
      "default": "All collections"
    },
    {
      "type": "header",
      "content": "Card Options"
    },
    {
      "type": "checkbox",
      "id": "show_collection_title",
      "label": "Show collection title",
      "default": true,
      "info": "Turn off when the artwork already names the collection. The title stays available to screen readers."
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show product count",
      "default": true,
      "info": "Displays '10 items' beneath the collection name"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ayira Collection List",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
