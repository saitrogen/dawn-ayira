{{ 'section-ayira-footer.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .ayira-footer--{{ section.id }} {
    margin-top: {{ section.settings.margin_top }}px;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<footer class="ayira-footer ayira-footer--{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="ayira-footer__inner page-width">
    <small class="ayira-footer__copyright">
      &copy; {{ 'now' | date: '%Y' }}, {{ shop.name | link_to: routes.root_url }}
    </small>
    <ul class="ayira-footer__links list-unstyled" role="list">
      {%- if section.settings.contact_page != blank -%}
        <li><a href="{{ section.settings.contact_page.url }}">{{ section.settings.contact_page.title | escape }}</a></li>
      {%- endif -%}
      {%- if section.settings.show_policy -%}
        {%- for policy in shop.policies -%}
          {%- if policy != blank -%}
            <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</footer>

{% schema %}
{
  "name": "Ayira footer",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-3" },
    { "type": "page", "id": "contact_page", "label": "Contact page" },
    { "type": "checkbox", "id": "show_policy", "default": true, "label": "Show policy links" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "margin_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top margin", "default": 0 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 24 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 24 }
  ],
  "presets": [{ "name": "Ayira footer" }]
}
{% endschema %}
